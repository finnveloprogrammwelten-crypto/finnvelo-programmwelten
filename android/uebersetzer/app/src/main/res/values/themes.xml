<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Thema" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/hintergrund</item>
        <item name="android:statusBarColor">@color/icon_hintergrund</item>
        <item name="android:navigationBarColor">@color/hintergrund</item>
        <item name="android:colorAccent">@color/primaer</item>
        <item name="android:colorPrimary">@color/primaer</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_leise</item>
    </style>

    <style name="Karte">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/karte</item>
        <item name="android:elevation">1dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="KartenTitel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Beschriftung">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/text_leise</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="KnopfPrimaer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/knopf_primaer</item>
        <item name="android:textColor">@color/auf_primaer</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="KnopfUmriss" parent="KnopfPrimaer">
        <item name="android:background">@drawable/knopf_umriss</item>
        <item name="android:textColor">@color/primaer</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="KameraSymbol">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/kamera_symbol</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="KameraThema" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
