<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/vorschau"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Foto + Kaesten: zusammen zoom- und verschiebbar -->
    <FrameLayout
        android:id="@+id/bildflaeche"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/standbild"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/kaesten"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Alle Uebersetzungen als Liste (gut bei Fahrplaenen, Stundenplaenen ...) -->
    <LinearLayout
        android:id="@+id/liste_tafel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="150dp"
        android:background="@drawable/tafel"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/liste_titel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#C7D2FE"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/liste_vorlesen"
                style="@style/TafelSymbol"
                android:text="🔊" />

            <TextView
                android:id="@+id/liste_kopieren"
                style="@style/TafelSymbol"
                android:text="📋" />

            <TextView
                android:id="@+id/liste_zu"
                style="@style/TafelSymbol"
                android:text="✕" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/liste_rollen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/liste_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Oben: Schliessen, Status, Taschenlampe -->
    <LinearLayout
        android:id="@+id/leiste_oben"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/verlauf_oben"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/knopf_zurueck"
            style="@style/KameraSymbol"
            android:text="✕" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/kamera_suche"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/knopf_licht"
            style="@style/KameraSymbol"
            android:text="🔦" />
    </LinearLayout>

    <!-- Unten: Galerie, Vorlesen, Ausloeser, Kopieren, Foto/Live -->
    <LinearLayout
        android:id="@+id/leiste_unten"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/verlauf_unten"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/knopf_galerie"
                style="@style/KameraSymbol"
                android:text="🖼" />

            <TextView
                android:id="@+id/knopf_vorlesen"
                style="@style/KameraSymbol"
                android:layout_marginStart="14dp"
                android:text="🔊" />

            <TextView
                android:id="@+id/knopf_ausloeser"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/kamera_ausloeser"
                android:gravity="center"
                android:text="📷"
                android:textColor="#1E3A8A"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/knopf_liste"
                style="@style/KameraSymbol"
                android:text="☰" />

            <TextView
                android:id="@+id/knopf_modus"
                style="@style/KameraSymbol"
                android:layout_marginStart="14dp"
                android:text="LIVE"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
