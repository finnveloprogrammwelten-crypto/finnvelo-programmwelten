# Kopfzeilen für Cloudflare (Pages / Workers Static Assets)

/einkaufsliste/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
  Cache-Control: public, max-age=31536000, immutable

/einkaufsliste/version.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store
  Access-Control-Allow-Origin: *

/einkaufsliste/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-store
  Service-Worker-Allowed: /einkaufsliste

/einkaufsliste/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-store

/einkaufsliste/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/einkaufsliste/*.png
  Cache-Control: public, max-age=604800

/einkaufsliste/hintergruende/*
  Content-Type: image/webp
  Cache-Control: public, max-age=2592000, immutable
